# ==============================================================================
# ENVIRONMENT VARIABLES SPECIFICATION: AURA ATTIRE E-COMMERCE SAMPLE
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND VARIABLES (Required for React / Vite client)
# These are embedded in the client build and are PUBLICLY readable in the browser.
# Set these in your local .env file or Cloudflare Pages environment settings.
# ------------------------------------------------------------------------------

# Your Supabase Project API URL (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Publishable / Anon Key (Dashboard -> Project Settings -> API)
# DO NOT put the service_role key here!
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Your Razorpay Test Key ID (Razorpay Dashboard -> Settings -> API Keys)
# Format: rzp_test_xxxxxxxxxxxxxx
# Safe to expose in the frontend because it only identifies your account for test checkout.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx


# ------------------------------------------------------------------------------
# BACKEND SECRETS (Required for Supabase Edge Functions)
# CRITICAL SECURITY RULE:
# NEVER put these in frontend .env files or prefix them with VITE_.
# Set these securely using the Supabase CLI:
# supabase secrets set RAZORPAY_KEY_ID=... RAZORPAY_KEY_SECRET=... RAZORPAY_WEBHOOK_SECRET=...
# ------------------------------------------------------------------------------

# Razorpay Test Key ID (Backend needs this to invoke the Razorpay REST API)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Razorpay Test Key Secret (Used on the server for order creation & HMAC verification)
# NEVER reveal this secret to the client!
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (Configured in Razorpay Dashboard -> Settings -> Webhooks)
# Used to verify inbound webhook signatures via HMAC SHA256
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
